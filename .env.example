# ==============================================================================
# CacheCraft / CacheOpti - Environment Configuration
# ==============================================================================

# Note: The public REST Countries API v3.1 (https://restcountries.com/v3.1)
# is completely free, open, and requires NO API key.
# 
# However, if you are using an authenticated proxy, gateway, or another provider:
REST_COUNTRIES_API_KEY=

# Optional custom API base URL override
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1

# Authentication header mode: auto | header | bearer | query_param
REST_COUNTRIES_AUTH_TYPE=auto
